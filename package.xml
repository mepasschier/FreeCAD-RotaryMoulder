<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>Rotary Moulder Workbench</name>
  <description>Design rotary cookie moulder drums. Wraps flat cookie outlines onto a cylindrical drum and cuts drafted cavities, with engraved or embossed text and shape details, roster (lattice) details, docker pins, cutting cups, and pattern replication around the drum.</description>
  <version>1.3.0</version>
  <date>2026-05-27</date>
  <maintainer email="hello@mikesprototype.com">Mike Passchier</maintainer>
  <author email="hello@mikesprototype.com">Mike Passchier</author>
  <license file="LICENSE">LGPL-2.1-or-later</license>
  <url type="repository" branch="main">https://github.com/mepasschier/FreeCAD-RotaryMoulder</url>
  <url type="readme">https://github.com/mepasschier/FreeCAD-RotaryMoulder/blob/main/README.md</url>
  <url type="bugtracker">https://github.com/mepasschier/FreeCAD-RotaryMoulder/issues</url>
  <icon>Resources/icons/RotaryMoulder.svg</icon>
  <content>
    <workbench>
      <classname>RotaryMoulderWorkbench</classname>
      <subdirectory>./</subdirectory>
      <icon>Resources/icons/RotaryMoulder.svg</icon>
      <tag>cookie</tag>
      <tag>moulder</tag>
      <tag>biscuit</tag>
      <freecadmin>1.0</freecadmin>
      <depend>Curves</depend>
    </workbench>
  </content>
</package>
